{
  "name": "sistem-mbg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api": "wrangler dev --port 5001",
    "client": "vite",
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run api\" \"npm run client\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply sistem-mbg --local",
    "db:migrate:remote": "wrangler d1 migrations apply sistem-mbg --remote"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.152.0"
  }
}
